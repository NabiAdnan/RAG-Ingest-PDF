# Copy to .env for local dev. Never commit a real .env (see .gitignore).
# Deploy: set these same names as secrets in the host dashboard instead.
GEMINI_API_KEY=your_gemini_api_key_here
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
INNGEST_PRODUCTION=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Public backend URL, e.g. https://rag-ingest-backend.onrender.com
# Leave empty locally; required on both deployed services.
RAG_BACKEND_URL=
# Local dev only: Inngest dev server API, used for query polling.
INNGEST_API_BASE=http://127.0.0.1:8288/v1
